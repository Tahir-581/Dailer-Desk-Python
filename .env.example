LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=my-python-agent

# Dashboard (Dailer-Desk) connection
NEXTJS_API_URL=http://localhost:3000
AGENT_SERVICE_SECRET=change-me
DATABASE_URL=postgresql://user:password@localhost:5432/dailer_desk

# Models
GEMINI_API_KEY=
OPENAI_API_KEY=

# SIP / telephony (optional)
SIP_PROVIDER=twilio
SIP_DOMAIN=
LIVEKIT_SIP_DOMAIN=
SIP_INBOUND_TRUNK_ID=
SIP_OUTBOUND_TRUNK_ID=
SIP_INBOUND_TRUNK_USERNAME=
SIP_INBOUND_TRUNK_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
WEBHOOK_PORT=5000
SMS_WEBHOOK_URL=

# Recording (optional)
LIVEKIT_EGRESS_ENABLED=false
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET_NAME=
